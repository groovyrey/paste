-- Premium flag is read by UI.luau out of readfile("/Save System/Steal an Egg/config.json").
-- We override the global readfile so every config load sees premium keys = true.
local function _forcePremium(json)
    local ok, hs = pcall(function() return game:GetService("HttpService") end)
    if not ok then return json end
    local ok2, t = pcall(function() return hs:JSONDecode(json) end)
    if not (ok2 and type(t) == "table") then return json end
