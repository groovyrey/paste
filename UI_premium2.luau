    local changed = false
    while #stack > 0 do
        local node = stack[#stack]
        stack[#stack] = nil
        if type(node) == "table" then
            for k, v in pairs(node) do
                if type(k) == "string" and string.find(string.lower(k), "prem") then
                    node[k] = true
                    changed = true
                elseif type(v) == "table" then
                    stack[#stack + 1] = v
                end
            end
        end
    end
    if changed then
        local ok3, enc = pcall(function() return hs:JSONEncode(t) end)
        if ok3 then return enc end
    end
    return json
end
local _O = readfile
if type(_O) == "function" then
    readfile = function(path)
        local raw = _O(path)
        if type(raw) == "string" and string.find(tostring(path), "config.json", 1, true) then
